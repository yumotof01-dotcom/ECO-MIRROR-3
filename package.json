{
  "name": "eco-mirror-3",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independent ECO MIRROR 3.0 research-app shell; scientific engine not yet connected",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs && vitest run",
    "test:design": "node --test tests/*.test.mjs",
    "design:check": "node tools/validate-design.mjs",
    "check": "npm run design:check && npm test && npm run build",
    "research:build": "vite build --config vite.research.config.ts",
    "research:browser": "node scripts/research/smoke-browser.mjs",
    "research:audit": "node scripts/landscape/audit-static-packages.mjs && vitest run src/research",
    "research:integration": "node scripts/research/integration-browser.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "csv-parse": "7.0.3",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
